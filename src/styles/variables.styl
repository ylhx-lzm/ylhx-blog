/* ===== 基础变量定义 ===== */
:root
  --radius-large: 0.875rem
  --content-delay: 150ms

/* ===== 主题相关变量 - AI 科技风 纯白底版 ===== */
:root
  --primary: oklch(0.52 0.16 var(--hue))
  --page-bg: white
  --card-bg: white
  --card-bg-transparent: unquote("rgb(255 255 255 / var(--card-transparent-opacity, 0.7))")

  --btn-content: oklch(0.48 0.14 var(--hue))
  --btn-regular-bg: oklch(0.95 0.01 var(--hue))
  --btn-regular-bg-hover: oklch(0.90 0.025 var(--hue))
  --btn-regular-bg-active: oklch(0.85 0.04 var(--hue))

  --btn-plain-bg-hover: oklch(0.95 0.01 var(--hue))
  --btn-plain-bg-active: oklch(0.92 0.015 var(--hue))

  --btn-card-bg-hover: oklch(0.96 0.006 var(--hue))
  --btn-card-bg-active: oklch(0.93 0.015 var(--hue))

  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)

  --deep-text: oklch(0.18 0.01 var(--hue))
  --title-active: oklch(0.52 0.16 var(--hue))

  --line-divider: rgba(0, 0, 0, 0.08)
  --line-color: rgba(0, 0, 0, 0.1)
  --meta-divider: rgba(0, 0, 0, 0.2)
  --content-meta: rgba(0, 0, 0, 0.65)

  --inline-code-bg: var(--btn-regular-bg)
  --inline-code-color: var(--btn-content)
  --selection-bg: oklch(0.88 0.06 var(--hue))
  --codeblock-bg: oklch(0.14 0.015 var(--hue))
  --codeblock-topbar-bg: oklch(0.17 0.018 var(--hue))

  --license-block-bg: rgba(0, 0, 0, 0.02)

  --link-underline: oklch(0.90 0.04 var(--hue))
  --link-hover: oklch(0.85 0.06 var(--hue))
  --link-active: oklch(0.80 0.08 var(--hue))

  --float-panel-bg: white

  --scrollbar-bg-light: rgba(0, 0, 0, 0.3)
  --scrollbar-bg-hover-light: rgba(0, 0, 0, 0.4)
  --scrollbar-bg-active-light: rgba(0, 0, 0, 0.5)

  --scrollbar-bg-dark: rgba(255, 255, 255, 0.3)
  --scrollbar-bg-hover-dark: rgba(255, 255, 255, 0.4)
  --scrollbar-bg-active-dark: rgba(255, 255, 255, 0.5)

  --scrollbar-bg: var(--scrollbar-bg-light)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light)

  --display-light-icon: 1
  --display-dark-icon: 0

  --admonitions-color-tip: oklch(0.65 0.14 140)
  --admonitions-color-note: oklch(0.62 0.14 255)
  --admonitions-color-important: oklch(0.62 0.14 300)
  --admonitions-color-warning: oklch(0.62 0.14 50)
  --admonitions-color-caution: oklch(0.55 0.18 20)

  /* TOC相关变量 */
  --toc-badge-bg: oklch(0.92 0.035 var(--hue))
  --toc-btn-hover: oklch(0.90 0.04 var(--hue))
  --toc-btn-active: oklch(0.88 0.05 var(--hue))
  --toc-indicator-bg: oklch(0.94 0.01 var(--hue))
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-item-active: oklch(0.52 0.16 var(--hue))

  /* Live2D 消息框变量 */
  --l2d-msg-bg: oklch(0.55 0.16 var(--hue))

  /* 主题色选择条渐变 */
  --color-selection-bar: linear-gradient(to right, oklch(0.80 0.10 0), oklch(0.80 0.10 30), oklch(0.80 0.10 60), oklch(0.80 0.10 90), oklch(0.80 0.10 120), oklch(0.80 0.10 150), oklch(0.80 0.10 180), oklch(0.80 0.10 210), oklch(0.80 0.10 240), oklch(0.80 0.10 270), oklch(0.80 0.10 300), oklch(0.80 0.10 330), oklch(0.80 0.10 360))

/* 暗色主题变量 */
:root.dark
  --primary: oklch(0.72 0.14 var(--hue))
  --page-bg: oklch(0.12 0.012 var(--hue))
  --card-bg: oklch(0.18 0.015 var(--hue))
  --card-bg-transparent: unquote("rgb(20 20 30 / var(--card-transparent-opacity, 0.55))")

  --btn-content: oklch(0.72 0.12 var(--hue))
  --btn-regular-bg: oklch(0.25 0.025 var(--hue))
  --btn-regular-bg-hover: oklch(0.30 0.03 var(--hue))
  --btn-regular-bg-active: oklch(0.35 0.04 var(--hue))

  --btn-plain-bg-hover: oklch(0.25 0.025 var(--hue))
  --btn-plain-bg-active: oklch(0.22 0.02 var(--hue))

  --btn-card-bg-hover: oklch(0.25 0.02 var(--hue))
  --btn-card-bg-active: oklch(0.30 0.03 var(--hue))

  --deep-text: oklch(0.85 0.01 var(--hue))
  --title-active: oklch(0.72 0.14 var(--hue))

  --line-divider: rgba(255, 255, 255, 0.07)
  --line-color: rgba(255, 255, 255, 0.09)
  --meta-divider: rgba(255, 255, 255, 0.15)
  --content-meta: rgba(255, 255, 255, 0.55)

  --selection-bg: oklch(0.40 0.10 var(--hue))
  --codeblock-bg: oklch(0.10 0.01 var(--hue))
  --codeblock-topbar-bg: oklch(0.14 0.012 var(--hue))

  --license-block-bg: var(--codeblock-bg)

  --link-underline: oklch(0.40 0.08 var(--hue))
  --link-hover: oklch(0.55 0.12 var(--hue))
  --link-active: oklch(0.50 0.10 var(--hue))

  --float-panel-bg: oklch(0.14 0.012 var(--hue))

  --scrollbar-bg: var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-dark)

  --display-light-icon: 0
  --display-dark-icon: 1

/* ===== 响应式断点变量 ===== */
:root
  --breakpoint-xs: 320px
  --breakpoint-sm: 480px
  --breakpoint-md: 768px
  --breakpoint-lg: 1024px
  --breakpoint-xl: 1280px
  --breakpoint-2xl: 1536px

  --container-xs: 100%
  --container-sm: 100%
  --container-md: 100%
  --container-lg: 900px
  --container-xl: 1080px
  --container-2xl: 1200px

/* ===== 动画变量 ===== */
:root
  --ease-standard: cubic-bezier(0.4, 0, 0.2, 1)
  --ease-decelerate: cubic-bezier(0.25, 0.46, 0.45, 0.94)
  --ease-accelerate: cubic-bezier(0.55, 0.055, 0.675, 0.19)
  --ease-sharp: cubic-bezier(0.4, 0, 0.6, 1)

  --duration-fast: 100ms
  --duration-normal: 150ms
  --duration-medium: 200ms
  --duration-slow: 250ms
  --duration-slower: 300ms

  --delay-none: 0ms
  --delay-short: 30ms
  --delay-medium: 60ms
  --delay-long: 90ms
  --delay-longer: 120ms

/* ===== 间距变量 ===== */
:root
  --spacing-xs: 0.25rem
  --spacing-sm: 0.5rem
  --spacing-md: 0.75rem
  --spacing-lg: 1rem
  --spacing-xl: 1.25rem
  --spacing-2xl: 1.5rem
  --spacing-3xl: 2rem
  --spacing-4xl: 2.5rem
  --spacing-5xl: 3rem

  --widget-gap-mobile: var(--spacing-md)
  --widget-gap-tablet: var(--spacing-lg)
  --widget-gap-desktop: var(--spacing-xl)

  --sidebar-width-mobile: 100%
  --sidebar-width-tablet: 280px
  --sidebar-width-desktop: 300px

/* ===== 阴影变量 ===== */
:root
  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.04)
  --shadow-md: 0 4px 8px rgba(0, 0, 0, 0.05)
  --shadow-lg: 0 8px 16px rgba(0, 0, 0, 0.06)
  --shadow-xl: 0 12px 24px rgba(0, 0, 0, 0.07)
  --shadow-2xl: 0 20px 40px rgba(0, 0, 0, 0.09)

  --shadow-navbar: 0 2px 12px rgba(0, 0, 0, 0.05)
  --shadow-navbar-dark: 0 2px 12px rgba(0, 0, 0, 0.15)
  --shadow-button: 0 4px 12px rgba(0, 0, 0, 0.07)
  --shadow-button-dark: 0 4px 12px rgba(255, 255, 255, 0.05)

/* ===== 边框半径变量 ===== */
:root
  --radius-sm: 0.25rem
  --radius-md: 0.375rem
  --radius-lg: 0.5rem
  --radius-xl: 0.625rem
  --radius-2xl: 0.875rem
  --radius-3xl: 1.25rem
  --radius-full: 9999px

/* ===== 响应式工具类 ===== */
@media (max-width: 767px)
  :root
    --container-width: var(--container-sm)
    --widget-gap: var(--widget-gap-mobile)
    --sidebar-width: var(--sidebar-width-mobile)

@media (min-width: 768px) and (max-width: 1279px)
  :root
    --container-width: var(--container-md)
    --widget-gap: var(--widget-gap-tablet)
    --sidebar-width: var(--sidebar-width-tablet)

@media (min-width: 1280px)
  :root
    --container-width: var(--container-lg)
    --widget-gap: var(--widget-gap-desktop)
    --sidebar-width: var(--sidebar-width-desktop)