---
import { Icon } from "astro-icon/components";

export interface Props {
	path: string;
	className?: string;
}

const { path, className = "" } = Astro.props;
---

<div
	class:list={[
		"firefly-d1-stats inline-flex flex-wrap items-center gap-3",
		className,
	]}
	data-d1-stats
	data-path={path}
>
	<span class="inline-flex items-center">
		<span class="meta-icon">
			<Icon name="material-symbols:visibility-outline-rounded" class="text-xl" />
		</span>
		<span class="text-50 text-sm font-medium mr-1">浏览</span>
		<span class="text-50 text-sm font-medium" data-d1-views>--</span>
	</span>
	<button
		type="button"
		class="inline-flex items-center text-neutral-500 dark:text-neutral-400 hover:text-(--primary) dark:hover:text-(--primary) transition"
		data-d1-like-button
		aria-pressed="false"
		aria-label="点赞"
	>
		<span class="meta-icon like-icon-outline">
			<Icon name="material-symbols:favorite-outline-rounded" class="text-xl" />
		</span>
		<span class="meta-icon like-icon-filled hidden">
			<Icon name="material-symbols:favorite-rounded" class="text-xl text-(--primary)" />
		</span>
		<span class="text-50 text-sm font-medium mr-1">点赞</span>
		<span class="text-50 text-sm font-medium" data-d1-likes>--</span>
	</button>
</div>

<style>
	button[data-d1-like-button][aria-pressed="true"] .like-icon-outline { display: none; }
	button[data-d1-like-button][aria-pressed="true"] .like-icon-filled { display: inline-flex !important; }
	button[data-d1-like-button][aria-pressed="true"] { color: var(--primary); }
</style>
